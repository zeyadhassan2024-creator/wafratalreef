# Public canonical origin for metadata, robots and sitemap (set during Cloudflare setup)
SITE_URL=https://your-domain.example

# Keep secrets in Cloudflare Worker secrets or local .dev.vars; never commit real values.
ADMIN_SETUP_KEY=generate-a-random-key-of-at-least-32-characters
RESEND_API_KEY=
RESEND_FROM=
